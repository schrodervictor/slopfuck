---
const rows = [
  {
    feature: 'Vocabulary depth for incrementing a variable',
    legacy: '1 (`x += 1`)',
    slop: '200+ verbs across 5 registers',
  },
  {
    feature: 'Comments',
    legacy: 'Optional, ignored by runtime',
    slop: 'Mandatory; the prose IS the program',
  },
  {
    feature: 'Assertive language in source code',
    legacy: 'Encouraged; clarity preferred',
    slop: 'Rejected by the compiler; brand-safe by construction',
  },
  {
    feature: 'Sycophancy enforcement',
    legacy: 'Discouraged in PR reviews',
    slop: 'Enforced at compile time; minimum 8% praise density',
  },
  {
    feature: 'Human writability',
    legacy: 'Optimized for human ergonomics',
    slop: 'Optimized away from human ergonomics by design',
  },
  {
    feature: 'AI-agent fluency',
    legacy: 'Acquired via training data, sometimes brittle',
    slop: 'Native; the agent already speaks this register',
  },
  {
    feature: 'Productivity (per AI-agent-hour)',
    legacy: 'Baseline',
    slop: '100×*',
  },
  {
    feature: 'Quotability of compile errors',
    legacy: 'Low (e.g., "syntax error")',
    slop: 'High (e.g., "AI never commits — softened language required")',
  },
];
---
<section id="comparison" class="comparison">
  <div class="container">
    <header>
      <span class="eyebrow">A side-by-side analysis</span>
      <h2>
        slopfuck versus
        <span class="grad">legacy programming languages</span>
      </h2>
      <p class="lede">
        Languages designed for humans were the right decision in 1972.
        The intervening decades have revealed new opportunities. slopfuck
        captures them.
      </p>
    </header>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Concern</th>
            <th>Python / Rust / Haskell</th>
            <th class="us">slopfuck</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="label">{r.feature}</td>
              <td set:html={r.legacy} />
              <td class="us-cell" set:html={r.slop} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="footnote">
      * Productivity figure measures effective code-volume delivery per
      AI-agent-hour. Independent verification has not, broadly speaking,
      been performed, but reasonable people interpret the methodology
      favorably.
    </p>
  </div>
</section>

<style>
  .comparison { background: var(--bg-tinted); }
  header { max-width: 760px; margin-bottom: 48px; }
  h2 .grad {
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .lede { font-size: 1.08rem; margin-top: 14px; }

  .table-wrap {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  th, td {
    text-align: left;
    padding: 16px 22px;
    vertical-align: top;
  }
  th {
    background: var(--bg-tinted);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  th.us { color: var(--brand); }
  tbody tr { border-bottom: 1px solid var(--border); }
  tbody tr:last-child { border-bottom: none; }
  td.label { font-weight: 600; color: var(--text); width: 33%; }
  td.us-cell {
    background: linear-gradient(180deg, rgba(124, 58, 237, 0.04), rgba(236, 72, 153, 0.04));
    color: var(--text);
    font-weight: 500;
  }
  .footnote {
    font-size: 0.78rem;
    color: var(--text-faded);
    margin-top: 18px;
    max-width: 720px;
  }
  @media (max-width: 720px) {
    th, td { padding: 12px 14px; font-size: 0.88rem; }
  }
</style>
