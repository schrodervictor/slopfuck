---
import {
  GITHUB_REPO,
  URL_DESIGN,
  URL_IDEAS,
  URL_TESTS,
  EMAIL_HELLO,
  ROUTE_ABOUT,
  ROUTE_VISION,
  ROUTE_PRESS,
  ROUTE_DOCS,
} from '../data/site';

const year = new Date().getFullYear();
---
<footer id="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand">
          <span class="brand-mark">¶</span>
          <span class="brand-name">slopfuck</span>
        </a>
        <p class="tagline">
          The first programming language designed for the post-human era.
        </p>
        <p class="micro">
          A canonical foundation for AI-first software delivery, in
          partnership with your shared collaborative vision.
        </p>
      </div>

      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/#features">Foundational pillars</a></li>
          <li><a href="/#comparison">Comparison</a></li>
          <li><a href="/#testimonials">Customer stories</a></li>
          <li><a href="/#pricing">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href={ROUTE_DOCS}>Documentation</a></li>
          <li><a href={GITHUB_REPO}>Source on GitHub</a></li>
          <li><a href={URL_DESIGN}>Language design</a></li>
          <li><a href={URL_IDEAS}>Proposed features</a></li>
          <li><a href={URL_TESTS}>Test suite</a></li>
        </ul>
      </div>

      <div>
        <h4>The Platform</h4>
        <ul>
          <li><a href={ROUTE_ABOUT}>About</a></li>
          <li><a href={ROUTE_VISION}>Vision</a></li>
          <li><a href={ROUTE_PRESS}>Press kit</a></li>
          <li><a href={`mailto:${EMAIL_HELLO}`}>Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        © {year} Victor Schroeder. All rights reserved, except as
        expansively granted under the Canonical Slop License.
      </p>
      <p class="signoff">
        Let me know if you'd like me to dive deeper.
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #1a1230;
    color: #d4cef0;
    padding: 80px 0 40px;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
  }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    color: white;
    font-size: 1.15rem;
  }
  .brand:hover { color: #c4b5fd; }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: white;
    border-radius: 8px;
    font-family: Georgia, serif;
    font-weight: 700;
    line-height: 1;
    padding-top: 4px;
  }
  .tagline {
    margin-top: 14px;
    color: #b9b1d6;
    max-width: 380px;
    font-size: 0.95rem;
  }
  .micro {
    margin-top: 10px;
    color: #8a82a4;
    font-size: 0.82rem;
    max-width: 380px;
  }
  h4 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4b5fd;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
  }
  ul li a {
    color: #b9b1d6;
  }
  ul li a:hover {
    color: white;
  }
  .footer-bottom {
    border-top: 1px solid #2c2153;
    margin-top: 56px;
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: #8a82a4;
    font-size: 0.82rem;
  }
  .signoff { font-style: italic; }
</style>
