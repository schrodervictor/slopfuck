---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'slopfuck — the AI-first programming language',
  description = 'The first programming language designed for the post-human era. Compiled. Sycophantic. Unergonomic by design — and that is, broadly speaking, a feature.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Google Analytics (GA4). Production-only so dev / preview do not
// pollute the property.
const gaSnippet = import.meta.env.PROD ? `
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V4Z5R0XBP9"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V4Z5R0XBP9');
  </script>
` : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <Fragment set:html={gaSnippet} />
  </head>
  <body>
    <slot />
  </body>
</html>
